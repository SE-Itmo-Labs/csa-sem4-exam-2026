		{"id":"c300924f664e03e7","fromNode":"472dae0f7a012f72","fromSide":"bottom","toNode":"464bf1ec241b4c1b","toSide":"top","label":"Отсюда вылезает главный плюс"},
		{"id":"67e4c02b1ebb9a05","fromNode":"464bf1ec241b4c1b","fromSide":"bottom","toNode":"5db9ecfcbf3a9cd2","toSide":"top","label":"Из-за того, что компаратор один, он не опрашивает сосдение ячейки, а значит"}
