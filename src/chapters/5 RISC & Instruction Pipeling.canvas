		{"id":"293f8953d49e8bd8","fromNode":"a04389b39226b2f5","fromSide":"left","toNode":"ec7a3fb65b91b0cc","toSide":"left"},
		{"id":"90e013f66beefe57","fromNode":"e8d449d6f16b5aac","fromSide":"left","toNode":"19bdb3a5aa9d2fa0","toSide":"left","label":"Этот мужчина \nв целом рассказал"},
		{"id":"17b12966c044f86e","fromNode":"bdb7236d3f169723","fromSide":"bottom","toNode":"599b29badee0fb2c","toSide":"top","color":"5"},
		{"id":"702b3c372c230501","fromNode":"bdb7236d3f169723","fromSide":"bottom","toNode":"f4f3a0f67e578767","toSide":"top","color":"5"},
		{"id":"6c82671c6eed1f87","fromNode":"f4f3a0f67e578767","fromSide":"bottom","toNode":"1c55e076c1bdc773","toSide":"top"},
		{"id":"50d6430faaad25e2","fromNode":"599b29badee0fb2c","fromSide":"bottom","toNode":"1c55e076c1bdc773","toSide":"top"},
		{"id":"484f20b961f3751a","fromNode":"296355a0d87b877e","fromSide":"right","toNode":"f4f3a0f67e578767","toSide":"right"},
		{"id":"a52cfaf2224cb8d5","fromNode":"296355a0d87b877e","fromSide":"left","toNode":"599b29badee0fb2c","toSide":"left"},
		{"id":"0f13051be87d7228","fromNode":"f577fb606b057d43","fromSide":"bottom","toNode":"daaef70e84d407ea","toSide":"top","color":"5","label":"Такая синяя штуковина снизу"},
		{"id":"4e193debc6150c38","fromNode":"9f87645fed1f1b54","fromSide":"left","toNode":"d4d4f555b2bf7096","toSide":"left","color":"5"},
		{"id":"732272e2ce830bb6","fromNode":"9f87645fed1f1b54","fromSide":"left","toNode":"e8d449d6f16b5aac","toSide":"left","color":"#00abad"},
		{"id":"323822883b16aa82","fromNode":"55bc61f3de7d10c8","fromSide":"right","toNode":"f23e8eba530f96f0","toSide":"right","label":"Appendix C где-то там"}
	]
}